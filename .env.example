# Paste the token only (the Bearer prefix is also accepted). Never use a VITE_ prefix.
UPSTOX_ACCESS_TOKEN=
MARKET_DATA_MODE=live
PORT=8080
PAPER_INITIAL_CAPITAL=1000000
# Simplified paper reserve per SHORT option lot, NOT broker SPAN/exposure margin.
PAPER_SHORT_MARGIN_PER_LOT=150000
# Flat simulated fee per fill. Taxes and exchange charges are not modelled.
PAPER_FEE_PER_ORDER=0
POLL_INTERVAL_SECONDS=3
DATA_DIR=data

# Algorithm dashboard (display only; no automated orders)
ALGO_OI_STRIKES_EACH_SIDE=7
ALGO_IV_STRIKES_EACH_SIDE=4
ALGO_IV_DIFFERENCE_THRESHOLD=2
ALGO_TREND_LOOKBACK_MINUTES=5
ALGO_EMA_PERIOD=20
ALGO_SUPERTREND_ATR_PERIOD=10
ALGO_SUPERTREND_MULTIPLIER=3
ALGO_SAR_STEP=0.02
ALGO_SAR_MAX=0.2
# underlying or option; changes all four technical indicators together
ALGO_INDICATOR_TARGET=underlying
ALGO_MAX_DATA_AGE_SECONDS=180
ALGO_REFRESH_SECONDS=15
