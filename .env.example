# Paste the token only (the Bearer prefix is also accepted). Never use a VITE_ prefix.
UPSTOX_ACCESS_TOKEN=
MARKET_DATA_MODE=live
PORT=8080
PAPER_INITIAL_CAPITAL=1000000
# Simplified paper reserve per SHORT option lot, NOT broker SPAN/exposure margin.
PAPER_SHORT_MARGIN_PER_LOT=150000
# Flat simulated fee per fill. Taxes and exchange charges are not modelled.
PAPER_FEE_PER_ORDER=0
POLL_INTERVAL_SECONDS=3
DATA_DIR=data
